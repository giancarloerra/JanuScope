{
  "name": "januscope",
  "mcpName": "io.github.giancarloerra/januscope",
  "version": "0.4.4",
  "description": "Local MCP policy proxy with response redaction, call auditing, tool restrictions, and schema context. Wrap an existing server with a YAML policy.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "januscope",
    "janus",
    "ai",
    "llm",
    "proxy",
    "middleware",
    "policy",
    "guardrails",
    "anthropic",
    "claude",
    "openai"
  ],
  "license": "AGPL-3.0-only",
  "author": "Giancarlo Erra - Altaire Limited",
  "homepage": "https://github.com/giancarloerra/januscope#readme",
  "bugs": {
    "url": "https://github.com/giancarloerra/januscope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giancarloerra/januscope.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "januscope": "./dist/cli.js"
  },
  "files": [
    "dist",
    "lenses/README.md",
    "lenses/databases",
    "lenses/dev-tools",
    "lenses/saas",
    "docs/setup.md",
    "docs/lenses.md",
    "schemas",
    "januscope.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "THIRD-PARTY-LICENSES"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "format": "prettier --write \"**/*.{ts,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json,yaml,yml}\"",
    "validate:lenses": "tsx scripts/validate-lenses.ts",
    "validate:metadata": "tsx scripts/sync-mcp-metadata.ts --check",
    "validate:lenses:strict": "tsx scripts/validate-lenses.ts --strict",
    "validate:lenses:probe": "tsx scripts/validate-lenses.ts --probe",
    "bench:overhead": "tsx scripts/bench-overhead.ts",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepublishOnly": "npm run validate:metadata && npm run typecheck && npm run lint && npm run format:check && npm test && npm run validate:lenses && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0",
    "mysql2": "^3.22.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "better-sqlite3": "^12.9.0",
    "eslint": "^10.3.0",
    "prettier": "^3.3.3",
    "release-it": "^21.0.0",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
